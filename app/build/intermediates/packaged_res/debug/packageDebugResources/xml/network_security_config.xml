<?xml version="1.0" encoding="utf-8"?>
<!--
    Autorise le trafic HTTP non chiffré UNIQUEMENT vers l'adresse locale de
    test (émulateur -> PC hôte). Tout le reste du trafic réseau de l'appli
    reste bloqué en clair (HTTPS obligatoire), comme avant.

    ⚠️ À retirer (ou à vider) une fois le backend déployé en HTTPS — ce
    fichier ne doit servir que pendant le développement local.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
