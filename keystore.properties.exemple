# Copie ce fichier en "keystore.properties" (sans le ".exemple"), à la
# RACINE du projet Android (à côté de settings.gradle.kts), et remplis
# avec tes vraies valeurs. Ce fichier ne doit JAMAIS être commité sur Git.

storeFile=pronosticapp-release.keystore
storePassword=TON_MOT_DE_PASSE_KEYSTORE
keyAlias=pronosticapp
